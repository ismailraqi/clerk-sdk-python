# Clerk Authentication Configuration
# Copy this file to .env and fill in your actual values

# Required: Your Clerk secret key from the dashboard
# Get this from: https://dashboard.clerk.com/last-active?path=api-keys
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Optional: Your Clerk JWT public key for local token verification
# Get this from: https://dashboard.clerk.com/last-active?path=api-keys (Show JWT public key)
# If not provided, tokens will be verified via API calls to Clerk
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----
your_jwt_public_key_here
-----END PUBLIC KEY-----"

# Optional: Clerk API URL (defaults to https://api.clerk.com)
# CLERK_API_URL=https://api.clerk.com

# Optional: Clerk API version (defaults to v1)
# CLERK_API_VERSION=v1

# Optional: Application configuration
# APP_NAME=FastAPI with Clerk
# APP_VERSION=1.0.0
# DEBUG=true

# Optional: CORS configuration for production
# ALLOWED_ORIGINS=https://your-frontend-domain.com,https://another-domain.com

# Optional: Database configuration (if you're extending this example)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Optional: Logging configuration
# LOG_LEVEL=INFO